# =========================
# FontExplorer - .gitignore
# =========================

# Node.js / npm
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Vite / frontend build output
dist/
.vite/

# Tauri / Rust build output
src-tauri/target/
src-tauri/gen/

# Environment variables and local secrets
.env
.env.*
!.env.example
!.env.*.example

# Tauri updater signing keys (never commit private keys)
src-tauri/*.key
src-tauri/*.key.pub
*.pem

# Logs and temporary files
*.log
logs/
tmp/
temp/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# IDE / editor settings
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.suo
*.user
*.userosscache
*.sln.docstates

# Rust / Cargo temporary files
**/*.rs.bk

# Test / coverage output
coverage/
.nyc_output/
